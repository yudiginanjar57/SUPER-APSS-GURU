# ==============================================================================
# GEMINI AI CONFIGURATION (Server-Side Only)
# ==============================================================================
# Kunci API Gemini untuk fitur EduAsisten Pedagogi, Penilaian AI, Ekstraksi Jadwal OCR, dll.
# Dikelola melalui menu Settings/Secrets di Google AI Studio.
GEMINI_API_KEY=

# ==============================================================================
# APPLICATION URL (Injected automatically in Cloud Run / AI Studio)
# ==============================================================================
APP_URL=

# ==============================================================================
# MYSQL DATABASE CONFIGURATION (Basis Data Relasional)
# ==============================================================================
# Opsi 1: URL Koneksi Lengkap (Connection String)
# Contoh: mysql://user:password@host:3306/database_name?ssl=true
DATABASE_URL=

# Opsi 2: Konfigurasi Parameter Individual
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jang_guru_db
MYSQL_SSL=false

