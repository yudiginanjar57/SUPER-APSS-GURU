rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Guru data sync collection for realtime cross-device syncing (HP ⇄ Laptop)
    match /guru_data/{syncId} {
      allow read, write: if syncId != null && syncId.size() > 0;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
